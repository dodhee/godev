---
import Layout from '~/layouts/PageLayout.astro';
import { Image } from 'astro:assets';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';

import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import TestimonialsCarousel from '~/components/widgets/TestimonialsCarousel.astro';

// SEO Schema Components
import LocalBusinessSchema from '~/components/seo/LocalBusinessSchema.astro';
import ServiceSchema from '~/components/seo/ServiceSchema.astro';

// Data
import { testimonials } from '~/data/testimonials';

// Blog preview images
import imgBlog1 from '~/images/blog/5_tanda_umkm_butuh_otomasi.jpg';
import imgBlog2 from '~/images/blog/cara_otomasi_buku_kas.jpg';
import imgBlog3 from '~/images/blog/roi_otomasi_sistem.jpg';

const metadata = {
  title: 'GoDev - Otomasi Usaha UMKM | Pemilik Bisa Libur Tenang',
  description:
    'Kami bereskan catatan keuangan, stok barang, dan balasan chat usaha Anda. Anda tinggal pakai dari HP, tanpa perlu paham IT.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
      <!-- Background gradients untuk enhance glass effect -->
  <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none" aria-hidden="true">
    <!-- Top area gradients - DIPERKUAT -->
    <div class="absolute -top-40 -right-40 w-175 h-175 bg-linear-to-br from-godev-primary/35 via-godev-primary/15 to-transparent blur-3xl rounded-full"></div>
    <div class="absolute top-1/4 -left-20 w-150 h-150 bg-linear-to-br from-blue-500/30 via-blue-500/12 to-transparent blur-3xl rounded-full"></div>
    
    <!-- Middle area gradients - DITAMBAH -->
    <div class="absolute top-1/3 right-1/4 w-125 h-125 bg-linear-to-br from-purple-500/25 via-purple-500/10 to-transparent blur-3xl rounded-full"></div>
    <div class="absolute top-1/2 left-1/4 w-112.5 h-112.5 bg-linear-to-tl from-godev-accent/30 via-godev-accent/12 to-transparent blur-3xl rounded-full"></div>
    
    <!-- Bottom area gradients - DIPERKUAT -->
    <div class="absolute bottom-1/4 left-1/3 w-150 h-150 bg-linear-to-tr from-godev-accent/35 via-godev-accent/15 to-transparent blur-3xl rounded-full"></div>
    <div class="absolute -bottom-40 -right-40 w-162.5 h-162.5 bg-linear-to-tl from-godev-primary/30 via-godev-primary/12 to-transparent blur-3xl rounded-full"></div>
  </div>
	
  <!-- Hero Section ******************* -->
  <Hero
      actions={[
        {
          variant: 'primary',
          text: 'Konsultasi Gratis',
          href: 'https://wa.me/6281234796567?text=Halo%20GoDev%2C%20saya%20mau%20konsultasi%20otomasi%20usaha.%0A%0ANama%20usaha%3A%20%5Bisi%20nama%20usaha%5D%0AMasalah%20utama%3A%20%5Bceritakan%20masalah%5D%0ABudget%20disiapkan%3A%20%5BRp%20...%5D',
          target: '_blank',
          icon: 'tabler:brand-whatsapp',
        },
      ]}
    >
    <Fragment slot="title">
      Usaha Jalan Terus, <br class="hidden sm:inline" />
      <span class="text-godev-primary dark:text-godev-primary">Pemilik Bisa Libur.</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-normal">
        Kami bereskan catatan keuangan, stok barang, dan balasan chat usaha Anda.<br />
        Anda tinggal pakai dari HP, <span class="font-semibold">tanpa perlu paham IT.</span>
      </span>
    </Fragment>


  </Hero>

  <!-- Problem Section *************** -->
  <Features
    id="masalah"
    title="Kenapa Pemilik UMKM Sering Pusing?"
    subtitle="Kami tahu persis masalah yang Anda hadapi setiap hari."
    items={[
      {
        title: 'Catatan Keuangan Campur Aduk',
        description: 'Uang pribadi dan modal usaha sering tertukar. Akhir bulan bingung untung atau rugi.',
        icon: 'tabler:calculator',
      },
      {
        title: 'Stok Barang Selalu Selisih',
        description: 'Tahu-tahu barang habis saat dicari pelanggan. Padahal kemarin masih ada di catatan.',
        icon: 'tabler:package',
      },
      {
        title: 'Ketinggalan Balas Chat Pelanggan',
        description: 'Sibuk urus admin manual, chat pelanggan terlambat dibalas. Pelanggan kabur ke kompetitor.',
        icon: 'tabler:message-off',
      },
    ]}
  />

    <!-- Solution Section ************** -->
      <section id="solusi" class="relative scroll-mt-18 not-prose">
              <div class="absolute inset-0 pointer-events-none z-[-1] bg-godev-primary/5 dark:bg-godev-primary/10" aria-hidden="true"></div>
        <div class="relative mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16 lg:py-20">
          <!-- Headline -->
          <div class="mb-8 md:mx-auto md:mb-12 text-center max-w-3xl">
            <h2 class="text-3xl md:text-4xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
              Solusi Otomatis, Usaha Jalan Terus
            </h2>
            <p class="text-xl text-muted">
              Kami buat sistem yang bekerja untuk Anda, bukan sebaliknya.
            </p>
          </div>

          <!-- Grid Cards -->
          <div class="grid gap-4 md:gap-6 gap-x-12 lg:grid-cols-3 sm:grid-cols-2">
            <div class="glass-card-md glass-floating relative flex flex-col p-6">
              <svg class="mb-6 w-12 h-12 text-primary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="12" x="2" y="6" rx="2"></rect>
                <circle cx="12" cy="12" r="2"></circle>
                <path d="M6 12h.01M18 12h.01"></path>
              </svg>
              <div class="text-xl font-bold">Buku Kas Otomatis</div>
              <p class="text-muted mt-2">Setiap transaksi masuk, langsung tercatat rapi. Tidak ada lagi uang bocor.</p>
            </div>

            <div class="glass-card-md glass-floating relative flex flex-col p-6">
              <svg class="mb-6 w-12 h-12 text-primary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 16v2a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h2"></path>
                <rect width="12" height="12" x="8" y="2" rx="2"></rect>
              </svg>
              <div class="text-xl font-bold">Kontrol Stok Real-time</div>
              <p class="text-muted mt-2">Pantau barang yang menipis langsung dari HP, kapan saja.</p>
            </div>

            <div class="glass-card-md glass-floating relative flex flex-col p-6">
              <svg class="mb-6 w-12 h-12 text-primary" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="7" height="12" x="2" y="6" rx="1"></rect>
                <path d="M13 8.32a7.43 7.43 0 0 1 0 7.36"></path>
                <path d="M16.46 6.21a11.76 11.76 0 0 1 0 11.58"></path>
                <path d="M19.91 4.1a15.91 15.91 0 0 1 .01 15.8"></path>
              </svg>
              <div class="text-xl font-bold">Sistem Booking/Order</div>
              <p class="text-muted mt-2">Pelanggan pesan sendiri, admin tinggal terima beres.</p>
            </div>
          </div>
        </div>
      </section>

  <!-- How It Works Section ********** -->
  <Steps
    title="Cara Kerja Kami: Simpel, Cepat, Beres"
    subtitle="Anda tidak perlu repot. Kami yang urus semuanya."
    items={[
      {
        title: 'Langkah 1: <span class="font-medium">Curhat Dulu</span>',
        description:
          'Ceritakan masalah usaha Anda via WhatsApp. Tidak usah formal, ngobrol santai saja. Konsultasi pertama gratis, tidak ada paksaan.',
        icon: 'tabler:message-circle',
      },
      {
        title: 'Langkah 2: <span class="font-medium">Kami Racik</span>',
        description: 'Tim kami buatkan sistemnya sesuai kebutuhan usaha Anda. Anda tidak perlu pusing mikir teknisnya.',
        icon: 'tabler:tool',
      },
      {
        title: 'Langkah 3: <span class="font-medium">Terima Beres</span>',
        description:
          'Kami latih Anda dan tim sampai bisa pakai sendiri. Setelah itu, sistem jalan otomatis. Anda tinggal pantau dari HP.',
        icon: 'tabler:check',
      },
      {
        title: 'Siap Libur!',
        description: 'Usaha jalan terus, pemilik bisa libur dengan tenang.',
        icon: 'tabler:beach',
      },
    ]}
  />

  <!-- Social Proof Section ********** -->
  <Features
    id="studi-kasus"
    title="Mereka Sudah Merasakan Manfaatnya"
    subtitle="Lihat bagaimana sistem otomatis mengubah cara kerja usaha mereka."
    items={[
      {
        title: 'Rental Mobil: Dari Pusing Catat Kunci, Jadi Otomatis di WA',
        description:
          'Admin tidak lagi salah catat jadwal sewa. Mobil tidak pernah bentrok lagi. Laporan keuangan harian otomatis masuk ke HP pemilik.',
        icon: 'tabler:car',
        callToAction: {
          text: 'Lihat Detail',
          href: '/studi-kasus/rental-mobil',
        },
      },
      {
        title: 'Homestay: Tamu Booking Sendiri, Pemilik Pantau dari Mana Saja',
        description:
          'Tamu cek ketersediaan kamar sendiri. Admin tidak perlu balas chat berulang. Pemilik bisa liburan tanpa khawatir.',
        icon: 'tabler:home',
        callToAction: {
          text: 'Lihat Detail',
          href: '/studi-kasus/homestay',
        },
      },
      {
        title: 'Toko Retail: Stok Opname 2 Hari Jadi 2 Jam',
        description:
          'Stok opname selesai dalam 2 jam. Pemilik tahu persis barang apa yang harus restok minggu ini. Tidak ada lagi barang hilang.',
        icon: 'tabler:shopping-cart',
        callToAction: {
          text: 'Lihat Detail',
          href: '/studi-kasus/toko-retail',
        },
      },
    ]}
    classes={{
      container: 'max-w-6xl',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-godev-primary/5 dark:bg-transparent"></div>
    </Fragment>
  </Features>

  <!-- Testimonials Section ********** -->
  <TestimonialsCarousel
    title="Kata Mereka yang Sudah Pakai GoDev"
    subtitle="Testimoni real dari pemilik UMKM di Surabaya dan sekitarnya"
    testimonials={testimonials}
  />

  <!-- Blog Preview Section *********** -->
  <section class="px-4 py-16 sm:px-6 lg:py-20 mx-auto max-w-7xl">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
        Tips Otomasi Bisnis dari <span class="text-godev-primary">Blog Kami</span>
      </h2>
      <p class="text-xl text-muted mt-4">
        Pelajari cara efisienkan operasional usaha Anda dengan artikel praktis kami
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <a href="/blog/5-tanda-umkm-butuh-otomasi" class="glass-card glass-shimmer overflow-hidden block">
        <div class="h-48 overflow-hidden">
          <Image
            src={imgBlog1}
            alt="5 Tanda UMKM Butuh Sistem Otomasi"
            width={480}
            height={192}
            class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-bold mb-2 hover:text-godev-primary">
            5 Tanda UMKM Anda Butuh Sistem Otomasi
          </h3>
          <p class="text-sm text-muted">
            Cek tanda-tanda ini sebelum kehilangan pelanggan karena sistem manual yang kacau.
          </p>
        </div>
      </a>

      <a href="/blog/cara-otomasi-buku-kas-google-sheets" class="glass-card glass-shimmer overflow-hidden block">
        <div class="h-48 overflow-hidden">
          <Image
            src={imgBlog2}
            alt="Cara Otomasi Buku Kas dengan Google Sheets"
            width={480}
            height={192}
            class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-bold mb-2 hover:text-godev-primary">
            Cara Otomasi Buku Kas dengan Google Sheets
          </h3>
          <p class="text-sm text-muted">
            Tutorial lengkap membuat buku kas otomatis tanpa coding. Bonus template gratis!
          </p>
        </div>
      </a>

      <a href="/blog/roi-investasi-sistem-otomasi" class="glass-card glass-shimmer overflow-hidden block">
        <div class="h-48 overflow-hidden">
          <Image
            src={imgBlog3}
            alt="ROI Investasi Sistem Otomasi untuk UMKM"
            width={480}
            height={192}
            class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
          />
        </div>
        <div class="p-6">
          <h3 class="text-lg font-bold mb-2 hover:text-godev-primary">
            ROI Investasi Sistem Otomasi
          </h3>
          <p class="text-sm text-muted">
            Perhitungan detail: berapa biaya, berapa savings, kapan break even?
          </p>
        </div>
      </a>
    </div>

    <div class="text-center">
      <a href="/blog" class="btn-secondary">
        Lihat Semua Artikel
      </a>
    </div>
  </section>

    <!-- Qualifier Section (Soft) ******* -->
  <section class="px-4 py-12 sm:px-6 mx-auto max-w-4xl">
    <div class="glass-card-md p-8 text-center">
      <h3 class="text-2xl font-bold mb-4">Siapa yang Cocok dengan GoDev?</h3>
      <div class="grid md:grid-cols-2 gap-6 text-left mt-8">
        <div>
          <h4 class="font-bold text-godev-primary mb-3 flex items-center">
            <span class="text-2xl mr-2">✅</span> Cocok untuk Anda jika:
          </h4>
          <ul class="space-y-2 text-muted">
            <li>• Serius mau rapikan sistem usaha</li>
            <li>• Punya budget minimal Rp 750.000</li>
            <li>• Siap implement dalam 1-2 minggu</li>
            <li>• Mau latihan pakai sistem baru</li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold text-red-600 mb-3 flex items-center">
            <span class="text-2xl mr-2">❌</span> Belum cocok jika:
          </h4>
          <ul class="space-y-2 text-muted">
            <li>• Cuma mau tanya-tanya gratis</li>
            <li>• Belum siap invest di sistem</li>
            <li>• Cari software gratis selamanya</li>
            <li>• Mau "coba dulu" tanpa komitmen</li>
          </ul>
        </div>
      </div>
      <p class="mt-6 text-sm text-muted italic">
        Kami hargai waktu Anda dan waktu kami. Konsultasi gratis untuk yang serius ingin perbaiki usahanya, bukan sekadar ngobrol.
      </p>
    </div>
  </section>

  <!-- Final CTA ********************* -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Konsultasi Gratis',
        href: 'https://wa.me/6281234796567?text=Halo%20GoDev%2C%20saya%20mau%20konsultasi%20otomasi%20usaha.%0A%0ANama%20usaha%3A%20%5Bisi%20nama%20usaha%5D%0AMasalah%20utama%3A%20%5Bceritakan%20masalah%5D%0ABudget%20disiapkan%3A%20%5BRp%20...%5D',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title">
      Masih Ragu? <br class="hidden sm:inline" />
      <span class="text-godev-accent">Ngobrol Gratis, Tidak Ada Paksaan.</span>
    </Fragment>

    <Fragment slot="subtitle">
      Ceritakan masalah usaha Anda. Kami beri saran gratis.<br class="hidden md:inline" />
      Konsultasi pertama selalu gratis. Tidak perlu langsung berlangganan.
    </Fragment>
  </CallToAction>

  <!-- SEO Schema -->
  <LocalBusinessSchema />
  <ServiceSchema />
</Layout>
