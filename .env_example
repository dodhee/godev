# ============================================
# GoDev Environment Variables
# ============================================
# Copy file ini menjadi .env dan isi dengan nilai asli Anda
# Jangan commit file .env ke Git!

# --------------------------------------------
# Form Kontak (Formspree)
# --------------------------------------------
# Daftar gratis di https://formspree.io
# 1. Sign up with email atau GitHub
# 2. Create new form
# 3. Copy endpoint URL (format: https://formspree.io/f/XXXXXXXX)
# 4. Paste di bawah (ganti YOUR_FORM_ID dengan ID asli)
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# --------------------------------------------
# Google Analytics (Optional, Post-Launch)
# --------------------------------------------
# Setup di https://analytics.google.com
# Format: G-XXXXXXXXXX (measurement ID)
# PUBLIC_GOOGLE_ANALYTICS_ID=

# --------------------------------------------
# Google Search Console (Optional, Post-Launch)
# --------------------------------------------
# Verification meta tag dari Search Console
# Format: <meta name="google-site-verification" content="XXXXXX" />
# PUBLIC_GOOGLE_SITE_VERIFICATION=