---
import { getUTMMessage } from '../../utils/UTMHelper';

interface Props {
  text?: string;
}

const { text = 'Konsultasi Sekarang' } = Astro.props;

const defaultMsg = 'Halo GoDev, saya tertarik konsultasi gratis tentang otomatisasi usaha saya.';
const message = getUTMMessage(Astro.url.toString(), defaultMsg);
const waLink = `https://wa.me/6281234796567?text=${encodeURIComponent(message)}`;
---

<a
  href={waLink}
  target="_blank"
  rel="noopener noreferrer"
  class="btn-godev-primary fixed bottom-4 right-4 md:bottom-6 md:right-6 z-50 shadow-lg animate-bounce text-sm md:text-base py-2.5 px-4 md:py-3.5 md:px-6"
>
  <span class="icon-[tabler--brand-whatsapp] mr-1.5 md:mr-2 h-5 w-5 md:h-6 md:w-6"></span>
  <span class="hidden sm:inline">{text}</span>
  <span class="sm:hidden">Chat</span>
</a>
