---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { resolveBlogImage } from '~/utils/blogImages';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = ['semua', ...new Set(posts.map((p) => p.data.category))];

const metadata = {
  title: 'Blog: Tips Otomasi Bisnis untuk UMKM Indonesia',
  description:
    'Artikel, tutorial, dan tips praktis tentang otomasi bisnis untuk UMKM. Belajar cara efisienkan operasional usaha Anda.',
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 lg:py-20 mx-auto max-w-7xl">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
        Blog <span class="text-godev-primary">GoDev</span>
      </h1>
      <p class="text-xl text-muted mt-4 max-w-3xl mx-auto">
        Tips praktis, tutorial lengkap, dan insight tentang otomasi bisnis untuk UMKM Indonesia.
        Ditulis berdasarkan pengalaman real di lapangan.
      </p>
    </div>

    <div class="flex flex-wrap justify-center gap-3 mb-12" id="filter-buttons">
      {
        categories.map((cat) => (
          <button
            data-filter={cat}
            class="filter-btn glass-badge hover:bg-gray-300 dark:hover:bg-slate-700"
          >
            {cat === 'semua' ? 'Semua Artikel' : cat}
          </button>
        ))
      }
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8" id="blog-grid">
      {
        posts.map((post) => {
          const image = resolveBlogImage(post.data.image);
          return (
            <article class="glass-card-md glass-shimmer overflow-hidden" data-category={post.data.category}>
              {image && (
                <a href={`/blog/${post.id}`} class="block h-48 overflow-hidden">
                  <Image
                    src={image}
                    alt={post.data.title}
                    width={600}
                    height={192}
                    class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                  />
                </a>
              )}
              <div class="p-6">
                <div class="flex items-center gap-3 mb-3 text-sm text-muted">
                  <span class="glass-badge">{post.data.category}</span>
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('id-ID')}
                  </time>
                </div>
                <h2 class="text-xl font-bold mb-3 hover:text-godev-primary">
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </h2>
                <p class="text-muted mb-4 line-clamp-3">{post.data.description}</p>
                <a
                  href={`/blog/${post.id}`}
                  class="inline-flex items-center text-godev-primary font-semibold hover:underline"
                >
                  Baca Selengkapnya
                  <Icon name="tabler:arrow-right" class="w-4 h-4 ml-2" />
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>
</Layout>

<style>
  .filter-btn-active {
    background: #556b2f !important;
    color: white !important;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('#blog-grid article');
  document.querySelector<HTMLButtonElement>('[data-filter="semua"]')?.classList.add('filter-btn-active');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'semua';
      buttons.forEach((b) => b.classList.remove('filter-btn-active'));
      btn.classList.add('filter-btn-active');
      cards.forEach((card) => {
        const category = card.dataset.category ?? '';
        card.style.display = filter === 'semua' || category === filter ? '' : 'none';
      });
    });
  });
</script>
