---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import TestimonialsCarousel from '~/components/widgets/TestimonialsCarousel.astro';

// SEO Schema Components
import LocalBusinessSchema from '~/components/seo/LocalBusinessSchema.astro';
import ServiceSchema from '~/components/seo/ServiceSchema.astro';

// Data
import { testimonials } from '~/data/testimonials';

const metadata = {
  title: 'GoDev - Otomasi Usaha UMKM | Pemilik Bisa Libur Tenang',
  description:
    'Kami bereskan catatan keuangan, stok barang, dan balasan chat usaha Anda. Anda tinggal pakai dari HP, tanpa perlu paham IT.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Section ******************* -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Konsultasi Gratis',
        href: 'https://wa.me/6281234796567?text=Halo%20GoDev%2C%20saya%20tertarik%20konsultasi%20gratis%20tentang%20otomatisasi%20usaha%20saya.',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title">
      Usaha Jalan Terus, <br class="hidden sm:inline" />
      <span class="text-godev-primary dark:text-godev-primary">Pemilik Bisa Libur.</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-normal">
        Kami bereskan catatan keuangan, stok barang, dan balasan chat usaha Anda.<br />
        Anda tinggal pakai dari HP, <span class="font-semibold">tanpa perlu paham IT.</span>
      </span>
    </Fragment>


  </Hero>

  <!-- Problem Section *************** -->
  <Features
    id="masalah"
    title="Kenapa Pemilik UMKM Sering Pusing?"
    subtitle="Kami tahu persis masalah yang Anda hadapi setiap hari."
    items={[
      {
        title: 'Catatan Keuangan Campur Aduk',
        description: 'Uang pribadi dan modal usaha sering tertukar. Akhir bulan bingung untung atau rugi.',
        icon: 'tabler:calculator',
      },
      {
        title: 'Stok Barang Selalu Selisih',
        description: 'Tahu-tahu barang habis saat dicari pelanggan. Padahal kemarin masih ada di catatan.',
        icon: 'tabler:package',
      },
      {
        title: 'Ketinggalan Balas Chat Pelanggan',
        description: 'Sibuk urus admin manual, chat pelanggan terlambat dibalas. Pelanggan kabur ke kompetitor.',
        icon: 'tabler:message-off',
      },
    ]}
  />

  <!-- Solution Section ************** -->
  <Features2
    title="Solusi Otomatis, Usaha Jalan Terus"
    subtitle="Kami buat sistem yang bekerja untuk Anda, bukan sebaliknya."
    items={[
      {
        title: 'Buku Kas Otomatis',
        description:
          'Setiap transaksi masuk langsung tercatat rapi. Laporan harian muncul sendiri di HP. Tidak ada lagi uang bocor.',
        icon: 'tabler:cash',
      },
      {
        title: 'Kontrol Stok Real-time',
        description:
          'Pantau barang yang menipis langsung dari HP, kapan saja. Notifikasi otomatis saat stok hampir habis.',
        icon: 'tabler:package',
      },
      {
        title: 'Sistem Booking/Order',
        description:
          'Pelanggan pesan sendiri lewat link. Admin tinggal terima beres. Tidak ada lagi chat yang kelewatan.',
        icon: 'tabler:device-mobile',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-godev-primary/5 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- How It Works Section ********** -->
  <Steps
    title="Cara Kerja Kami: Simpel, Cepat, Beres"
    subtitle="Anda tidak perlu repot. Kami yang urus semuanya."
    items={[
      {
        title: 'Langkah 1: <span class="font-medium">Curhat Dulu</span>',
        description:
          'Ceritakan masalah usaha Anda via WhatsApp. Tidak usah formal, ngobrol santai saja. Konsultasi pertama gratis, tidak ada paksaan.',
        icon: 'tabler:message-circle',
      },
      {
        title: 'Langkah 2: <span class="font-medium">Kami Racik</span>',
        description: 'Tim kami buatkan sistemnya sesuai kebutuhan usaha Anda. Anda tidak perlu pusing mikir teknisnya.',
        icon: 'tabler:tool',
      },
      {
        title: 'Langkah 3: <span class="font-medium">Terima Beres</span>',
        description:
          'Kami latih Anda dan tim sampai bisa pakai sendiri. Setelah itu, sistem jalan otomatis. Anda tinggal pantau dari HP.',
        icon: 'tabler:check',
      },
      {
        title: 'Siap Libur!',
        description: 'Usaha jalan terus, pemilik bisa libur dengan tenang.',
        icon: 'tabler:beach',
      },
    ]}
  />

  <!-- Social Proof Section ********** -->
  <Features
    id="studi-kasus"
    title="Mereka Sudah Merasakan Manfaatnya"
    subtitle="Lihat bagaimana sistem otomatis mengubah cara kerja usaha mereka."
    items={[
      {
        title: 'Rental Mobil: Dari Pusing Catat Kunci, Jadi Otomatis di WA',
        description:
          'Admin tidak lagi salah catat jadwal sewa. Mobil tidak pernah bentrok lagi. Laporan keuangan harian otomatis masuk ke HP pemilik.',
        icon: 'tabler:car',
        callToAction: {
          text: 'Lihat Detail',
          href: '/studi-kasus/rental-mobil',
        },
      },
      {
        title: 'Homestay: Tamu Booking Sendiri, Pemilik Pantau dari Mana Saja',
        description:
          'Tamu cek ketersediaan kamar sendiri. Admin tidak perlu balas chat berulang. Pemilik bisa liburan tanpa khawatir.',
        icon: 'tabler:home',
        callToAction: {
          text: 'Lihat Detail',
          href: '/studi-kasus/homestay',
        },
      },
      {
        title: 'Toko Retail: Stok Opname 2 Hari Jadi 2 Jam',
        description:
          'Stok opname selesai dalam 2 jam. Pemilik tahu persis barang apa yang harus restok minggu ini. Tidak ada lagi barang hilang.',
        icon: 'tabler:shopping-cart',
        callToAction: {
          text: 'Lihat Detail',
          href: '/studi-kasus/toko-retail',
        },
      },
    ]}
    classes={{
      container: 'max-w-6xl',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-godev-primary/5 dark:bg-transparent"></div>
    </Fragment>
  </Features>

  <!-- Testimonials Section ********** -->
  <TestimonialsCarousel
    title="Kata Mereka yang Sudah Pakai GoDev"
    subtitle="Testimoni real dari pemilik UMKM di Surabaya dan sekitarnya"
    testimonials={testimonials}
  />

  <!-- Blog Preview Section *********** -->
  <section class="px-4 py-16 sm:px-6 lg:py-20 mx-auto max-w-7xl">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
        Tips Otomasi Bisnis dari <span class="text-godev-primary">Blog Kami</span>
      </h2>
      <p class="text-xl text-muted mt-4">
        Pelajari cara efisienkan operasional usaha Anda dengan artikel praktis kami
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <a href="/blog/5-tanda-umkm-butuh-otomasi" class="glass-card overflow-hidden block">
        <div class="h-48 bg-linear-to-br from-godev-primary to-godev-accent"></div>
        <div class="p-6">
          <h3 class="text-lg font-bold mb-2 hover:text-godev-primary">
            5 Tanda UMKM Anda Butuh Sistem Otomasi
          </h3>
          <p class="text-sm text-muted">
            Cek tanda-tanda ini sebelum kehilangan pelanggan karena sistem manual yang kacau.
          </p>
        </div>
      </a>

      <a href="/blog/cara-otomasi-buku-kas-google-sheets" class="glass-card overflow-hidden block">
        <div class="h-48 bg-linear-to-br from-blue-500 to-blue-700"></div>
        <div class="p-6">
          <h3 class="text-lg font-bold mb-2 hover:text-godev-primary">
            Cara Otomasi Buku Kas dengan Google Sheets
          </h3>
          <p class="text-sm text-muted">
            Tutorial lengkap membuat buku kas otomatis tanpa coding. Bonus template gratis!
          </p>
        </div>
      </a>

      <a href="/blog/roi-investasi-sistem-otomasi" class="glass-card overflow-hidden block">
        <div class="h-48 bg-linear-to-br from-green-500 to-green-700"></div>
        <div class="p-6">
          <h3 class="text-lg font-bold mb-2 hover:text-godev-primary">
            ROI Investasi Sistem Otomasi
          </h3>
          <p class="text-sm text-muted">
            Perhitungan detail: berapa biaya, berapa savings, kapan break even?
          </p>
        </div>
      </a>
    </div>

    <div class="text-center">
      <a href="/blog" class="btn-secondary">
        Lihat Semua Artikel
      </a>
    </div>
  </section>

  <!-- Final CTA ********************* -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Ngobrol Gratis Sekarang',
        href: 'https://wa.me/6281234796567?text=Halo%20GoDev%2C%20saya%20tertarik%20konsultasi%20gratis%20tentang%20otomatisasi%20usaha%20saya.',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title">
      Masih Ragu? <br class="hidden sm:inline" />
      <span class="text-godev-accent">Ngobrol Gratis, Tidak Ada Paksaan.</span>
    </Fragment>

    <Fragment slot="subtitle">
      Ceritakan masalah usaha Anda. Kami beri saran gratis.<br class="hidden md:inline" />
      Konsultasi pertama selalu gratis. Tidak perlu langsung berlangganan.
    </Fragment>
  </CallToAction>

  <!-- SEO Schema -->
  <LocalBusinessSchema />
  <ServiceSchema />
</Layout>
