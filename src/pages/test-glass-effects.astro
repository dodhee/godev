---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Test Glass Effects - GoDev',
  description: 'Testing page untuk verifikasi semua glass effects',
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 lg:py-20 mx-auto max-w-7xl">
    <h1 class="text-4xl font-bold mb-12 text-center">Test Glass Effects</h1>

    <!-- Test 1: Glass Card -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold mb-4">1. Glass Card (border-radius: 20px)</h2>
      <div class="glass-card p-6 max-w-md">
        <h3 class="font-bold mb-2">Test Glass Card</h3>
        <p class="text-muted">This should have glass effect with 20px border radius and backdrop blur.</p>
      </div>
    </div>

    <!-- Test 2: Glass Card MD -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold mb-4">2. Glass Card MD (border-radius: 16px)</h2>
      <div class="glass-card-md p-6 max-w-md">
        <h3 class="font-bold mb-2">Test Glass Card MD</h3>
        <p class="text-muted">This should have glass effect with 16px border radius.</p>
      </div>
    </div>

    <!-- Test 3: Glass Floating -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold mb-4">3. Glass Floating Animation</h2>
      <div class="glass-card-md glass-floating p-6 max-w-md">
        <h3 class="font-bold mb-2">Test Floating Animation</h3>
        <p class="text-muted">This card should float up and down slowly (10px in 6 seconds).</p>
      </div>
    </div>

    <!-- Test 4: Glass Badge -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold mb-4">4. Glass Badge</h2>
      <div class="flex gap-3">
        <span class="glass-badge">Tutorial</span>
        <span class="glass-badge">Tips Bisnis</span>
        <span class="glass-badge">ROI & Investasi</span>
      </div>
    </div>

    <!-- Test 5: Glass Shimmer -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold mb-4">5. Glass Shimmer Effect (hover to see)</h2>
      <div class="glass-card-md glass-shimmer p-6 max-w-md">
        <h3 class="font-bold mb-2">Test Shimmer Effect</h3>
        <p class="text-muted">Hover over this card to see the shimmer animation moving from left to right.</p>
      </div>
    </div>

    <!-- Test 6: All Combined -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold mb-4">6. All Combined (Glass + Floating + Shimmer)</h2>
      <div class="glass-card-md glass-floating glass-shimmer p-6 max-w-md">
        <h3 class="font-bold mb-2">All Effects Combined</h3>
        <p class="text-muted">This has glass effect, floating animation, and shimmer on hover.</p>
      </div>
    </div>

    <!-- Grid of Cards -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold mb-4">7. Grid of Cards (seperti di Blog)</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="glass-card-md glass-shimmer overflow-hidden">
          <div class="h-32 bg-linear-to-br from-godev-primary to-godev-accent"></div>
          <div class="p-4">
            <span class="glass-badge mb-2 inline-block">Tutorial</span>
            <h3 class="font-bold mb-2">Card Title 1</h3>
            <p class="text-sm text-muted">Card description goes here.</p>
          </div>
        </div>
        <div class="glass-card-md glass-shimmer overflow-hidden">
          <div class="h-32 bg-linear-to-br from-blue-500 to-blue-700"></div>
          <div class="p-4">
            <span class="glass-badge mb-2 inline-block">Tips</span>
            <h3 class="font-bold mb-2">Card Title 2</h3>
            <p class="text-sm text-muted">Card description goes here.</p>
          </div>
        </div>
        <div class="glass-card-md glass-shimmer overflow-hidden">
          <div class="h-32 bg-linear-to-br from-green-500 to-green-700"></div>
          <div class="p-4">
            <span class="glass-badge mb-2 inline-block">ROI</span>
            <h3 class="font-bold mb-2">Card Title 3</h3>
            <p class="text-sm text-muted">Card description goes here.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Dark Mode Test -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold mb-4">8. Dark Mode Test</h2>
      <p class="mb-4 text-muted">Toggle dark mode di header untuk test glass effects di dark mode.</p>
      <div class="glass-card p-6 max-w-md">
        <h3 class="font-bold mb-2">Dark Mode Support</h3>
        <p class="text-muted">Glass effects should adapt to dark mode automatically.</p>
      </div>
    </div>

    <!-- Back Button -->
    <div class="text-center mt-12">
      <a href="/" class="btn-primary">← Kembali ke Homepage</a>
    </div>
  </section>
</Layout>
