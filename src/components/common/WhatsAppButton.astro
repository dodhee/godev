---
import { getUTMMessage } from '../../utils/UTMHelper';

interface Props {
  text?: string;
}

const { text = 'Konsultasi Sekarang' } = Astro.props;

const defaultMsg = 'Halo godev, saya tertarik konsultasi gratis tentang otomatisasi usaha saya.';
const message = getUTMMessage(Astro.url.toString(), defaultMsg);
const waLink = `https://wa.me/6281234796567?text=${encodeURIComponent(message)}`;
---

<a
  href={waLink}
  target="_blank"
  rel="noopener noreferrer"
  class="btn-godev-primary fixed bottom-6 right-6 z-50 shadow-lg animate-bounce"
>
  <span class="icon-[tabler--brand-whatsapp] mr-2 h-6 w-6"></span>
  {text}
</a>
